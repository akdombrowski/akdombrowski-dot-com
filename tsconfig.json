{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/actions/*": ["./src/actions/*"],
      "@/db/*": ["./src/db/*"],
      "@/supabase/*": ["./src/db/supabase/*"],
      "@/blogs/*": ["src/app/(content)/blogs/*"],
      "@/videos/*": ["./src/components/videos/*"],
      "@/social/*": ["./src/components/social/*"],
      "@/social": ["./src/components/social/"]
    }
  },
  "include": ["**/*.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"],
  "mdx": {
    // Enable strict type checking in MDX files.
    "checkMdx": true
  }
}
